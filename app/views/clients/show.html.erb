<!-- app/views/clients/show.html.erb -->
<div class="container mt-4">
  <% if @client.present? %>
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><%= @client["name"] %></h1>
      <div>
        <%= link_to clients_path, class: "btn btn-outline-secondary me-2" do %>
          <i class="bi bi-arrow-left"></i> Back to Clients
        <% end %>
        <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLIENTS_BOARD_ID'] %>/pulses/<%= @client["id"] %>" class="btn btn-primary" target="_blank">
          <i class="bi bi-pencil"></i> Edit in Monday.com
        </a>
      </div>
    </div>

    <% 
      # Helper method to get column value by ID
      def get_column_text(client, column_id)
        column = client["column_values"].find { |col| col["id"] == column_id }
        if column && column["text"].present?
          column["text"]
        else
          "N/A"
        end
      end
      
      # Get status for badge
      status_column = @client["column_values"].find { |col| col["id"] == "status" }
      status = status_column && status_column["text"].present? ? status_column["text"] : "Unknown"
      status_class = case status
                     when "Active" then "bg-success"
                     when "Inactive" then "bg-secondary"
                     when "Pending" then "bg-warning"
                     else "bg-info"
                     end
    %>

    <!-- Status Badge -->
    <div class="mb-4">
      <span class="badge <%= status_class %> fs-5"><%= status %></span>
    </div>

    <div class="row">
      <!-- Main Client Information -->
      <div class="col-md-8">
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Client Information</h3>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <table class="table table-borderless">
                  <tr>
                    <th>Name</th>
                    <td><%= @client["name"] %></td>
                  </tr>
                  <tr>
                    <th>Phone</th>
                    <% 
                      phone_column = @client["column_values"].find { |col| col["id"].include?("phone") || col["title"].to_s.downcase.include?("phone") }
                      phone = phone_column && phone_column["text"].present? ? phone_column["text"] : "N/A"
                    %>
                    <td>
                      <% if phone != "N/A" %>
                        <a href="tel:<%= phone %>"><%= phone %></a>
                      <% else %>
                        <%= phone %>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <th>Email</th>
                    <% 
                      email_column = @client["column_values"].find { |col| col["id"].include?("email") || col["title"].to_s.downcase.include?("email") }
                      email = email_column && email_column["text"].present? ? email_column["text"] : "N/A"
                    %>
                    <td>
                      <% if email != "N/A" %>
                        <a href="mailto:<%= email %>"><%= email %></a>
                      <% else %>
                        <%= email %>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <th>Client Since</th>
                    <% 
                      date_column = @client["column_values"].find { |col| col["type"] == "date" || col["title"].to_s.downcase.include?("date") }
                      client_since = date_column && date_column["text"].present? ? date_column["text"] : "N/A"
                    %>
                    <td><%= client_since %></td>
                  </tr>
                </table>
              </div>
              <div class="col-md-6">
                <table class="table table-borderless">
                  <tr>
                    <th>Assigned Person</th>
                    <td><%= get_column_text(@client, "person") %></td>
                  </tr>
                  <tr>
                    <th>Client Type</th>
                    <% 
                      type_column = @client["column_values"].find { |col| col["id"].include?("type") || col["title"].to_s.downcase.include?("type") }
                      client_type = type_column && type_column["text"].present? ? type_column["text"] : "N/A"
                    %>
                    <td><%= client_type %></td>
                  </tr>
                  <tr>
                    <th>Status</th>
                    <td><span class="badge <%= status_class %>"><%= status %></span></td>
                  </tr>
                  <tr>
                    <th>Last Update</th>
                    <td><%= @client["updated_at"] ? Time.at(@client["updated_at"].to_i/1000).strftime("%B %-d, %Y") : "N/A" %></td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Address Information -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-info text-white">
            <h3 class="mb-0">Address Information</h3>
          </div>
          <div class="card-body">
            <% 
              address_column = @client["column_values"].find { |col| col["id"].include?("address") || col["title"].to_s.downcase.include?("address") }
              city_column = @client["column_values"].find { |col| col["id"].include?("city") || col["title"].to_s.downcase.include?("city") }
              state_column = @client["column_values"].find { |col| col["id"].include?("state") || col["title"].to_s.downcase.include?("state") }
              zip_column = @client["column_values"].find { |col| col["id"].include?("zip") || col["id"].include?("postal") || col["title"].to_s.downcase.include?("zip") }
              
              address = address_column && address_column["text"].present? ? address_column["text"] : "N/A"
              city = city_column && city_column["text"].present? ? city_column["text"] : "N/A"
              state = state_column && state_column["text"].present? ? state_column["text"] : "N/A"
              zip = zip_column && zip_column["text"].present? ? zip_column["text"] : "N/A"
              
              full_address = [address, city, state, zip].reject { |part| part == "N/A" }.join(", ")
            %>
            
            <p class="mb-2"><strong>Full Address:</strong> <%= full_address.present? ? full_address : "N/A" %></p>
            
            <div class="row mt-3">
              <div class="col-md-6">
                <p><strong>Street:</strong> <%= address %></p>
                <p><strong>City:</strong> <%= city %></p>
              </div>
              <div class="col-md-6">
                <p><strong>State:</strong> <%= state %></p>
                <p><strong>ZIP:</strong> <%= zip %></p>
              </div>
            </div>
            
            <% 
              # Check if there's a location column with coordinates
              location_column = @client["column_values"].find { |col| col["type"] == "location" }
              lat = nil
              lng = nil
              
              if location_column && location_column["value"].present?
                begin
                  location_data = JSON.parse(location_column["value"])
                  if location_data["lat"].present? && location_data["lng"].present?
                    lat = location_data["lat"]
                    lng = location_data["lng"]
                  end
                rescue JSON::ParserError
                  # Handle parsing error
                end
              end
            %>
            
            <% if lat.present? && lng.present? %>
              <div class="mt-3">
                <div id="map" style="height: 300px; width: 100%;"></div>
                <script>
                  document.addEventListener('DOMContentLoaded', function() {
                    const map = L.map('map').setView([<%= lat %>, <%= lng %>], 15);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    }).addTo(map);
                    L.marker([<%= lat %>, <%= lng %>]).addTo(map)
                      .bindPopup("<%= full_address.gsub('"', '\"') %>")
                      .openPopup();
                  });
                </script>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Notes Section -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-success text-white">
            <h3 class="mb-0">Client Notes</h3>
          </div>
          <div class="card-body">
            <% 
              notes_column = @client["column_values"].find { |col| col["type"] == "long_text" || col["id"].include?("notes") || col["title"].to_s.downcase.include?("notes") }
              notes = notes_column && notes_column["text"].present? ? notes_column["text"] : "No notes available for this client."
            %>
            <div class="p-3 bg-light rounded">
              <%= simple_format(notes) %>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar Information -->
      <div class="col-md-4">
        <!-- Related Claims -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-secondary text-white">
            <h3 class="mb-0">Related Claims</h3>
          </div>
          <div class="card-body">
            <% if @related_claims.present? && @related_claims.any? %>
              <div class="list-group">
                <% @related_claims.each do |claim| %>
                  <%= link_to claim_path(claim["id"]), class: "list-group-item list-group-item-action" do %>
                    <div class="d-flex w-100 justify-content-between">
                      <h5 class="mb-1"><%= claim["name"] %></h5>
                      <% 
                        claim_status_column = claim["column_values"].find { |col| col["id"] == "status" }
                        claim_status = claim_status_column && claim_status_column["text"].present? ? claim_status_column["text"] : "Unknown"
                        claim_status_class = case claim_status
                                           when "Claim Closed" then "bg-success"
                                           when "In Progress" then "bg-primary"
                                           when "Pending" then "bg-warning"
                                           when "Denied" then "bg-danger"
                                           else "bg-secondary"
                                           end
                      %>
                      <span class="badge <%= claim_status_class %>"><%= claim_status %></span>
                    </div>
                    <% 
                      claim_number_column = claim["column_values"].find { |col| col["id"] == "text_mkpb2b25" }
                      claim_number = claim_number_column && claim_number_column["text"].present? ? claim_number_column["text"] : "N/A"
                      
                      date_of_loss_column = claim["column_values"].find { |col| col["id"] == "text_mkpbby4g" }
                      date_of_loss = date_of_loss_column && date_of_loss_column["text"].present? ? date_of_loss_column["text"] : "N/A"
                    %>
                    <p class="mb-1">Claim #: <%= claim_number %></p>
                    <small class="text-muted">Date of Loss: <%= date_of_loss %></small>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted">No claims associated with this client.</p>
              <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLAIMS_BOARD_ID'] %>" class="btn btn-sm btn-primary" target="_blank">
                <i class="bi bi-plus-circle"></i> Create New Claim
              </a>
            <% end %>
          </div>
        </div>

        <!-- Additional Information -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Additional Information</h3>
          </div>
          <div class="card-body">
            <% 
              # Look for additional useful information
              additional_columns = @client["column_values"].select do |col| 
                !["status", "person", "text", "email", "phone", "date", "address", "city", "state", "zip", "long_text"].include?(col["type"]) &&
                !col["id"].include?("notes") && 
                !col["id"].include?("address") && 
                !col["id"].include?("email") && 
                !col["id"].include?("phone")
              end
            %>
            
            <% if additional_columns.any? %>
              <table class="table table-sm">
                <% additional_columns.each do |column| %>
                  <% if column["text"].present? %>
                    <tr>
                      <th><%= column["title"] || column["id"] %></th>
                      <td><%= column["text"] %></td>
                    </tr>
                  <% end %>
                <% end %>
              </table>
            <% else %>
              <p class="text-muted">No additional information available.</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Debug Information (only in development) -->
    <% if Rails.env.development? %>
      <div class="card mt-4 mb-4">
        <div class="card-header bg-light">
          <h3 class="mb-0">Debug Information</h3>
        </div>
        <div class="card-body">
          <pre class="bg-light p-3"><%= JSON.pretty_generate(@client) %></pre>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="alert alert-danger">
      <h3>Client not found</h3>
      <p>The requested client could not be found or there was an error retrieving the data.</p>
      <%= link_to "Return to Clients List", clients_path, class: "btn btn-primary mt-3" %>
    </div>
  <% end %>
</div>

<!-- Include Leaflet for maps -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>