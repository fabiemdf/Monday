<!-- app/views/clients/edit.html.erb -->
<div class="container mt-4">
  <% if @client.present? %>
    <div class="mb-4">
      <%= link_to client_path(@client["id"]), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left"></i> Back to Client
      <% end %>
      
      <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLIENTS_BOARD_ID'] %>/pulses/<%= @client["id"] %>" class="btn btn-outline-primary ms-2" target="_blank">
        <i class="bi bi-pencil-square"></i> Edit in Monday.com
      </a>
    </div>
    
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Edit Client: <%= @client["name"] %></h4>
        <% status = get_column_value(@client, "Status") %>
        <span id="status_preview" class="badge <%= status_badge_class(status) %>">
          <%= status %>
        </span>
      </div>
      
      <div class="card-body">
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i> Some fields can only be edited directly in Monday.com. Changes made here will synchronize with Monday.com.
        </div>
        
        <%= form_with url: client_path(@client["id"]), method: :patch, local: true, scope: :client, class: "client-form" do |form| %>
          <% if flash[:alert].present? %>
            <div class="alert alert-danger">
              <%= flash[:alert] %>
            </div>
          <% end %>
          
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :status, "Status", class: "form-label fw-bold" %>
                <div class="input-group">
                  <%= form.select :status, 
                      monday_status_options(@client), 
                      { selected: get_column_value(@client, "Status").downcase.gsub(/\s+/, '_') }, 
                      class: "form-select", 
                      data: { original: get_column_value(@client, "Status").downcase.gsub(/\s+/, '_') } %>
                  <span class="input-group-text status-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
                <small class="text-muted">Current status in Monday.com: <%= get_column_value(@client, "Status") %></small>
              </div>
              
              <div class="mb-3">
                <%= form.label :name, "Client Name", class: "form-label fw-bold" %>
                <div class="input-group">
                  <%= form.text_field :name, 
                      value: @client["name"], 
                      class: "form-control",
                      data: { original: @client["name"] } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
              
              <div class="mb-3">
                <%= form.label :phone, "Phone", class: "form-label fw-bold" %>
                <% phone_column = @client["column_values"].find { |col| col["id"].include?("phone") || col["title"] == "Phone" } %>
                <% phone = phone_column && phone_column["text"].present? ? phone_column["text"] : "" %>
                <div class="input-group">
                  <%= form.telephone_field :phone, 
                      value: phone, 
                      class: "form-control",
                      data: { original: phone } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
              
              <div class="mb-3">
                <%= form.label :email, "Email", class: "form-label fw-bold" %>
                <% email_column = @client["column_values"].find { |col| col["id"].include?("email") || col["title"] == "Email" } %>
                <% email = email_column && email_column["text"].present? ? email_column["text"] : "" %>
                <div class="input-group">
                  <%= form.email_field :email, 
                      value: email, 
                      class: "form-control",
                      data: { original: email } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :address, "Address", class: "form-label fw-bold" %>
                <% address_column = @client["column_values"].find { |col| col["id"].include?("address") || col["title"] == "Address" } %>
                <% address = address_column && address_column["text"].present? ? address_column["text"] : "" %>
                <div class="input-group">
                  <%= form.text_field :address, 
                      value: address, 
                      class: "form-control",
                      data: { original: address } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
              
              <div class="mb-3">
                <%= form.label :city, "City", class: "form-label fw-bold" %>
                <% city_column = @client["column_values"].find { |col| col["id"].include?("city") || col["title"] == "City" } %>
                <% city = city_column && city_column["text"].present? ? city_column["text"] : "" %>
                <div class="input-group">
                  <%= form.text_field :city, 
                      value: city, 
                      class: "form-control",
                      data: { original: city } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
              
              <div class="mb-3">
                <%= form.label :state, "State", class: "form-label fw-bold" %>
                <% state_column = @client["column_values"].find { |col| col["id"].include?("state") || col["title"] == "State" } %>
                <% state = state_column && state_column["text"].present? ? state_column["text"] : "" %>
                <div class="input-group">
                  <%= form.text_field :state, 
                      value: state, 
                      class: "form-control",
                      data: { original: state } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
              
              <div class="mb-3">
                <%= form.label :zip, "ZIP Code", class: "form-label fw-bold" %>
                <% zip_column = @client["column_values"].find { |col| col["id"].include?("zip") || col["id"].include?("postal") || col["title"] == "ZIP" } %>
                <% zip = zip_column && zip_column["text"].present? ? zip_column["text"] : "" %>
                <div class="input-group">
                  <%= form.text_field :zip, 
                      value: zip, 
                      class: "form-control",
                      data: { original: zip } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="card mb-4 border">
            <div class="card-header bg-light">
              <h5 class="mb-0">Notes & Details</h5>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <%= form.label :notes, "Notes", class: "form-label fw-bold" %>
                <% notes_column = @client["column_values"].find { |col| col["type"] == "long_text" || col["id"].include?("notes") || col["title"] == "Notes" } %>
                <% notes = notes_column && notes_column["text"].present? ? notes_column["text"] : "" %>
                <div class="input-group">
                  <%= form.text_area :notes, 
                      value: notes, 
                      rows: 5, 
                      class: "form-control",
                      data: { original: notes } %>
                  <span class="input-group-text field-indicator">
                    <i class="bi bi-circle-fill text-muted"></i>
                  </span>
                </div>
                <small class="text-muted">These notes will be visible to all users with access to this client.</small>
              </div>
            </div>
          </div>
          
          <div class="card mb-4 border">
            <div class="card-header bg-light">
              <h5 class="mb-0">Actions</h5>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <%= link_to client_path(@client["id"]), class: "btn btn-outline-secondary me-2" do %>
                    <i class="bi bi-x-lg"></i> Cancel
                  <% end %>
                  
                  <button type="button" class="btn btn-outline-danger me-2" data-bs-toggle="modal" data-bs-target="#resetFormModal">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset Form
                  </button>
                </div>
                
                <div class="d-flex align-items-center">
                  <span id="save-status" class="me-3 text-muted">No changes</span>
                  <%= form.button type: "submit", class: "btn btn-primary", id: "save-button", disabled: true do %>
                    <i class="bi bi-cloud-arrow-up"></i> Update in Monday.com
                  <% end %>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Reset Form Confirmation Modal -->
          <div class="modal fade" id="resetFormModal" tabindex="-1" aria-labelledby="resetFormModalLabel" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="resetFormModalLabel">Reset Form?</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  Are you sure you want to reset all fields to their original values? Any changes you've made will be lost.
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="button" class="btn btn-danger" id="confirm-reset">Reset Form</button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="alert alert-warning">
      <i class="bi bi-exclamation-triangle me-2"></i> Client not found
    </div>
    <div class="mt-3">
      <%= link_to clients_path, class: "btn btn-primary" do %>
        <i class="bi bi-arrow-left"></i> Back to Clients
      <% end %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Track form changes
    const formInputs = document.querySelectorAll('.client-form input, .client-form select, .client-form textarea');
    const saveButton = document.getElementById('save-button');
    const saveStatus = document.getElementById('save-status');
    
    formInputs.forEach(input => {
      input.addEventListener('change', function() {
        const hasChanges = checkForChanges();
        saveButton.disabled = !hasChanges;
        saveStatus.textContent = hasChanges ? 'Changes pending' : 'No changes';
        saveStatus.className = hasChanges ? 'me-3 text-warning' : 'me-3 text-muted';
        
        // Update field indicator
        const indicator = this.parentNode.querySelector('.field-indicator i');
        if (indicator) {
          if (this.value !== this.dataset.original) {
            indicator.className = 'bi bi-circle-fill text-warning';
          } else {
            indicator.className = 'bi bi-circle-fill text-muted';
          }
        }
      });
    });
    
    // Reset form button
    const resetButton = document.getElementById('confirm-reset');
    resetButton.addEventListener('click', function() {
      formInputs.forEach(input => {
        input.value = input.dataset.original;
        
        // Reset indicators
        const indicator = input.parentNode.querySelector('.field-indicator i');
        if (indicator) {
          indicator.className = 'bi bi-circle-fill text-muted';
        }
      });
      
      // Update save button
      saveButton.disabled = true;
      saveStatus.textContent = 'No changes';
      saveStatus.className = 'me-3 text-muted';
      
      // Close modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('resetFormModal'));
      modal.hide();
    });
    
    function checkForChanges() {
      let hasChanges = false;
      formInputs.forEach(input => {
        if (input.value !== input.dataset.original) {
          hasChanges = true;
        }
      });
      return hasChanges;
    }
  });
</script>