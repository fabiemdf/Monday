<!-- app/views/clients/index.html.erb -->
<div class="container mt-4">
  <!-- Add inline CSS -->
  <style>
    .table-resizable th {
      position: relative;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    
    .column-resizer {
      position: absolute;
      top: 0;
      right: 0;
      width: 5px;
      height: 100%;
      background-color: transparent;
      cursor: col-resize;
      user-select: none;
      touch-action: none;
    }
    
    .column-resizer:hover,
    .column-resizer:active {
      background-color: rgba(0, 0, 0, 0.1);
    }
    
    body.resizing-columns {
      cursor: col-resize;
      user-select: none;
    }
  </style>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Clients</h1>
    <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLIENTS_BOARD_ID'] %>" class="btn btn-primary" target="_blank">
      <i class="bi bi-plus-circle"></i> New Client
    </a>
  </div>

  <!-- Search form -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= form_with url: clients_path, method: :get, class: "row g-3", data: { turbo: false } do |f| %>
        <div class="col-md-4">
          <%= f.label :search, "Search", class: "form-label" %>
          <%= f.text_field :search, value: params[:search], class: "form-control", placeholder: "Search clients..." %>
        </div>
        <div class="col-md-3">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, 
                      [["All Statuses", ""], "Active", "Inactive", "Pending"], 
                      { selected: params[:status] }, 
                      { class: "form-select" } %>
        </div>
        <div class="col-md-3">
          <%= f.label :sort, "Sort By", class: "form-label" %>
          <%= f.select :sort, 
                      [["Name (A-Z)", "name_asc"], ["Name (Z-A)", "name_desc"], 
                       ["Status (A-Z)", "status_asc"], ["Status (Z-A)", "status_desc"],
                       ["Date (Newest)", "date_desc"], ["Date (Oldest)", "date_asc"]], 
                      { selected: params[:sort] || "name_asc" }, 
                      { class: "form-select" } %>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <%= f.submit "Filter", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Expand/Collapse All Button -->
  <div class="mb-3">
    <button id="toggleAllGroups" class="btn btn-outline-secondary">
      <i class="bi bi-arrows-expand"></i> Expand/Collapse All
    </button>
  </div>

