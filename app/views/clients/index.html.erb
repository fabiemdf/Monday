<!-- app/views/clients/index.html.erb -->
<div class="container mt-4">
  <!-- Debug Information - Only shown in development -->
  <% if Rails.env.development? %>
    <div class="card mb-4 border-danger">
      <div class="card-header bg-danger text-white">
        <h3 class="mb-0">Debug Information</h3>
      </div>
      <div class="card-body">
        <h5>API Response Overview:</h5>
        <ul>
          <li><strong>API Response Keys:</strong> <%= @clients_data.present? ? @clients_data.keys.join(', ') : 'No response data' %></li>
          <li><strong>Board ID:</strong> <%= ENV['MONDAY_CLIENTS_BOARD_ID'] || 'Not set' %></li>
          <li><strong>Data Present:</strong> <%= @clients_data.present? && @clients_data.dig("data").present? ? 'Yes' : 'No' %></li>
          <li><strong>Boards Present:</strong> <%= @clients_data.dig("data", "boards").present? ? 'Yes' : 'No' %></li>
          <li><strong>Items Count:</strong> <%= @clients_data.dig("data", "boards", 0, "items_page", "items")&.length || 'No items' %></li>
          <li><strong>Groups Count:</strong> <%= @clients_data.dig("data", "boards", 0, "groups")&.length || 'No groups' %></li>
          <li><strong>Clients by Group:</strong> <%= @clients_by_group.present? ? @clients_by_group.keys.join(', ') : 'Not grouped' %></li>
          <li><strong>Sorted Groups:</strong> <%= @sorted_groups.present? ? @sorted_groups.join(', ') : 'Not sorted' %></li>
        </ul>

        <% if @clients_data.present? && @clients_data.dig("data", "boards", 0, "items_page", "items").present? %>
          <h5>First 3 Items Sample:</h5>
          <% @clients_data.dig("data", "boards", 0, "items_page", "items").first(3).each_with_index do |item, index| %>
            <div class="p-2 mb-2 bg-light rounded">
              <strong>Item <%= index + 1 %>:</strong> <%= item["name"] %> (ID: <%= item["id"] %>)<br>
              <strong>Group:</strong> <%= item.dig("group", "title") || 'No group' %><br>
              <strong>Column Values:</strong> <%= item["column_values"]&.length || 0 %> columns
            </div>
          <% end %>
        <% end %>

        <% if @clients_data.present? && @clients_data["errors"].present? %>
          <h5 class="text-danger">API Errors:</h5>
          <pre class="bg-light p-3"><%= JSON.pretty_generate(@clients_data["errors"]) rescue @clients_data["errors"].inspect %></pre>
        <% end %>

        <details>
          <summary>View Full API Response</summary>
          <pre class="bg-light p-3"><%= JSON.pretty_generate(@clients_data) rescue @clients_data.inspect %></pre>
        </details>
      </div>
    </div>
  <% end %>

<% if Rails.env.development? %>
  <div class="alert alert-info">
    <h4>Debug Information</h4>
    <p>clients_by_group: <%= @clients_by_group.present? ? @clients_by_group.keys : 'Not present' %></p>
    <p>sorted_groups: <%= @sorted_groups.present? ? @sorted_groups : 'Not present' %></p>
  </div>
<% end %>

  <% if @clients_by_group.present? && @clients_by_group.any? %>
    <% @sorted_groups.each_with_index do |group_title, index| %>
      <% group_items = @clients_by_group[group_title] %>
      <% 
        # Pagination for this group
        total_pages = (group_items.size.to_f / @page_size).ceil
        start_index = (@page - 1) * @page_size
        end_index = [start_index + @page_size - 1, group_items.size - 1].min
        paginated_items = group_items[start_index..end_index]
        
        # Generate a unique ID for this group
        group_id = "group-#{group_title.parameterize}"
        
        # Check if this group should be expanded (default to expanded for the first group)
        expanded = index == 0
      %>
      
      <div class="card mb-4 shadow-sm group-card" id="<%= group_id %>-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="mb-0 d-flex align-items-center">
            <button class="btn btn-link text-decoration-none me-2 group-toggle" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#<%= group_id %>-body" 
                    aria-expanded="<%= expanded ? 'true' : 'false' %>"
                    aria-controls="<%= group_id %>-body">
              <i class="bi <%= expanded ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i>
            </button>
            <%= group_title %>
          </h3>
          <span class="badge bg-primary"><%= group_items.size %> clients</span>
        </div>
        
        <div class="collapse <%= expanded ? 'show' : '' %>" id="<%= group_id %>-body">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped table-hover mb-0 table-resizable">
                <thead>
                  <tr>
                    <th><%= sortable_column("Client Name", "name") %></th>
                    <th><%= sortable_column("Status", "status") %></th>
                    <th><%= sortable_column("Phone", "phone") %></th>
                    <th><%= sortable_column("Email", "email") %></th>
                    <th><%= sortable_column("Address", "address") %></th>
                    <th><%= sortable_column("Assigned To", "person") %></th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% paginated_items.each do |client| %>
                    <tr>
                      <td><%= client["name"] %></td>
                      <td>
                        <% 
                          # Get the status column data
                          status_column = client["column_values"].find { |col| col["id"] == "status" || col["title"] == "Status" }
                          
                          # Extract the text if the column exists and has text
                          status_text = if status_column && status_column["text"].present?
                                          status_column["text"]
                                        else
                                          "Unknown"
                                        end

                          # Define the badge class
                          status_class = case status_text
                                        when "Active" then "bg-success"
                                        when "Inactive" then "bg-secondary"
                                        when "Pending" then "bg-warning"
                                        else "bg-info"
                                        end
                        %>
                        <span class="badge <%= status_class %>">
                          <%= status_text %>
                        </span>
                      </td>
                      <td>
                        <% 
                          phone_column = client["column_values"].find { |col| col["id"].include?("phone") || col["title"] == "Phone" }
                          phone = phone_column && phone_column["text"].present? ? phone_column["text"] : "N/A"
                        %>
                        <% if phone != "N/A" %>
                          <a href="tel:<%= phone %>"><%= phone %></a>
                        <% else %>
                          <%= phone %>
                        <% end %>
                      </td>
                      <td>
                        <% 
                          email_column = client["column_values"].find { |col| col["id"].include?("email") || col["title"] == "Email" }
                          email = email_column && email_column["text"].present? ? email_column["text"] : "N/A"
                        %>
                        <% if email != "N/A" %>
                          <a href="mailto:<%= email %>"><%= email %></a>
                        <% else %>
                          <%= email %>
                        <% end %>
                      </td>
                      <td>
                        <% 
                          address_column = client["column_values"].find { |col| col["id"].include?("address") || col["title"] == "Address" }
                          address = address_column && address_column["text"].present? ? address_column["text"] : "N/A"
                        %>
                        <%= address %>
                      </td>
                      <td>
                        <% 
                          person_column = client["column_values"].find { |col| col["id"] == "person" || col["title"] == "Person" }
                          person = person_column && person_column["text"].present? ? person_column["text"] : "N/A"
                        %>
                        <%= person %>
                      </td>
                      <td>
                        <div class="btn-group">
                          <%= link_to client_path(client["id"]), class: "btn btn-sm btn-primary" do %>
                            <i class="bi bi-eye"></i> View
                          <% end %>
                          <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLIENTS_BOARD_ID'] %>/pulses/<%= client["id"] %>" class="btn btn-sm btn-secondary" target="_blank">
                            <i class="bi bi-pencil"></i> Edit
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <% if total_pages > 1 %>
              <div class="card-footer">
                <nav aria-label="Page navigation">
                  <ul class="pagination justify-content-center mb-0">
                    <% if @page > 1 %>
                      <li class="page-item">
                        <%= link_to "Previous", clients_path(page: @page - 1, page_size: @page_size, search: params[:search], status: params[:status], sort: params[:sort]), class: "page-link" %>
                      </li>
                    <% else %>
                      <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                      </li>
                    <% end %>
                    
                    <% (1..total_pages).each do |page_num| %>
                      <li class="page-item <%= 'active' if page_num == @page %>">
                        <%= link_to page_num.to_s, clients_path(page: page_num, page_size: @page_size, search: params[:search], status: params[:status], sort: params[:sort]), class: "page-link" %>
                      </li>
                    <% end %>
                    
                    <% if @page < total_pages %>
                      <li class="page-item">
                        <%= link_to "Next", clients_path(page: @page + 1, page_size: @page_size, search: params[:search], status: params[:status], sort: params[:sort]), class: "page-link" %>
                      </li>
                    <% else %>
                      <li class="page-item disabled">
                        <span class="page-link">Next</span>
                      </li>
                    <% end %>
                  </ul>
                </nav>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="alert alert-info">
      <h4>No clients found</h4>
      <p>No clients match your search criteria. Try adjusting your filters or create a new client.</p>
    </div>
  <% end %>

  <% if Rails.env.development? %>
    <div class="card mb-4">
      <div class="card-header">
        <h3>Debug Information</h3>
      </div>
      <div class="card-body">
        <p>Groups: <%= @sorted_groups.join(", ") if @sorted_groups.present? %></p>
        <p>Clients by Group: <%= @clients_by_group.keys if @clients_by_group.present? %></p>
        <p>Page: <%= @page %>, Page Size: <%= @page_size %></p>
        <% if @clients_data.present? %>
          <details>
            <summary>API Response</summary>
            <pre><%= JSON.pretty_generate(@clients_data) rescue @clients_data.inspect %></pre>
          </details>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Add inline JavaScript at the end of the file -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Setting up resizable columns');
      setupResizableColumns();
      
      // Toggle individual group
      const groupToggles = document.querySelectorAll('.group-toggle');
      groupToggles.forEach(toggle => {
        toggle.addEventListener('click', function() {
          const icon = this.querySelector('i');
          if (icon.classList.contains('bi-chevron-right')) {
            icon.classList.replace('bi-chevron-right', 'bi-chevron-down');
          } else {
            icon.classList.replace('bi-chevron-down', 'bi-chevron-right');
          }
        });
      });
      
      // Toggle all groups
      const toggleAllBtn = document.getElementById('toggleAllGroups');
      toggleAllBtn.addEventListener('click', function() {
        const allGroups = document.querySelectorAll('.group-card');
        const firstGroup = allGroups[0];
        const firstGroupBody = document.getElementById(firstGroup.id.replace('-card', '-body'));
        const isExpanded = firstGroupBody.classList.contains('show');
        
        allGroups.forEach(group => {
          const groupId = group.id.replace('-card', '');
          const groupBody = document.getElementById(groupId + '-body');
          const groupToggle = group.querySelector('.group-toggle i');
          
          if (isExpanded) {
            // Collapse all
            groupBody.classList.remove('show');
            groupToggle.classList.replace('bi-chevron-down', 'bi-chevron-right');
          } else {
            // Expand all
            groupBody.classList.add('show');
            groupToggle.classList.replace('bi-chevron-right', 'bi-chevron-down');
          }
        });
      });
    });

    function setupResizableColumns() {
      const tables = document.querySelectorAll('.table-resizable');
      console.log('Found tables:', tables.length);
      
      tables.forEach(table => {
        const headers = table.querySelectorAll('th');
        console.log('Found headers:', headers.length);
        
        headers.forEach((header, index) => {
          // Skip the Actions column (last column)
          if (index < headers.length - 1) {
            const resizer = document.createElement('div');
            resizer.classList.add('column-resizer');
            header.appendChild(resizer);
            setupResizer(resizer, header);
            console.log('Added resizer to:', header.textContent);
          }
        });
      });
    }

    function setupResizer(resizer, header) {
      let startX, startWidth;
      
      const mouseDownHandler = (e) => {
        e.preventDefault();
        startX = e.clientX;
        startWidth = header.offsetWidth;
        
        document.addEventListener('mousemove', mouseMoveHandler);
        document.addEventListener('mouseup', mouseUpHandler);
        
        // Add a class to the body to indicate we're resizing
        document.body.classList.add('resizing-columns');
        console.log('Started resizing:', header.textContent);
      };
      
      const mouseMoveHandler = (e) => {
        // Calculate the new width
        const width = startWidth + (e.clientX - startX);
        
        // Set a minimum width of 50px
        if (width >= 50) {
          header.style.width = `${width}px`;
          header.style.minWidth = `${width}px`;
          console.log('Resizing to:', width);
        }
      };
      
      const mouseUpHandler = () => {
        document.removeEventListener('mousemove', mouseMoveHandler);
        document.removeEventListener('mouseup', mouseUpHandler);
        document.body.classList.remove('resizing-columns');
        console.log('Finished resizing');
        
        // Save the width to localStorage
        const columnName = header.textContent.trim();
        const width = header.offsetWidth;
        saveColumnWidth(columnName, width);
      };
      
      resizer.addEventListener('mousedown', mouseDownHandler);
      
      // Apply saved width if available
      const savedWidth = getSavedColumnWidth(header.textContent.trim());
      if (savedWidth) {
        header.style.width = `${savedWidth}px`;
        header.style.minWidth = `${savedWidth}px`;
        console.log('Applied saved width:', savedWidth);
      }
    }

    function saveColumnWidth(columnName, width) {
      const storageKey = 'clientsTableColumnWidths';
      const savedWidths = JSON.parse(localStorage.getItem(storageKey) || '{}');
      savedWidths[columnName] = width;
      localStorage.setItem(storageKey, JSON.stringify(savedWidths));
      console.log('Saved width for:', columnName, width);
    }

    function getSavedColumnWidth(columnName) {
      const storageKey = 'clientsTableColumnWidths';
      const savedWidths = JSON.parse(localStorage.getItem(storageKey) || '{}');
      return savedWidths[columnName];
    }
  </script>
</div>