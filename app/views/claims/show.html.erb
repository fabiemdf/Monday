<!-- app/views/claims/show.html.erb -->
<div class="container mt-4">
  <% if @claim.present? %>
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><%= @claim["name"] %></h1>
      <div>
        <%= link_to claims_path, class: "btn btn-outline-secondary me-2" do %>
          <i class="bi bi-arrow-left"></i> Back to Claims
        <% end %>
        <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLAIMS_BOARD_ID'] %>/pulses/<%= @claim["id"] %>" class="btn btn-primary" target="_blank">
          <i class="bi bi-pencil"></i> Edit in Monday.com
        </a>
      </div>
    </div>

    <% 
      # Helper method to get column value by ID
      def get_column_text(claim, column_id)
        column = claim["column_values"].find { |col| col["id"] == column_id }
        if column && column["text"].present?
          column["text"]
        else
          "N/A"
        end
      end
      
      # Get status for badge
      status_column = @claim["column_values"].find { |col| col["id"] == "status" }
      status = status_column && status_column["text"].present? ? status_column["text"] : "Unknown"
      status_class = case status
                     when "Claim Closed" then "bg-success"
                     when "In Progress" then "bg-primary"
                     when "Pending" then "bg-warning"
                     when "Denied" then "bg-danger"
                     else "bg-secondary"
                     end
    %>

    <!-- Status Badge -->
    <div class="mb-4">
      <span class="badge <%= status_class %> fs-5"><%= status %></span>
    </div>

    <div class="row">
      <!-- Main Claim Information -->
      <div class="col-md-8">
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Claim Information</h3>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <table class="table table-borderless">
                  <tr>
                    <th>Claim Number</th>
                    <td><%= get_column_text(@claim, "text_mkpb2b25") %></td>
                  </tr>
                  <tr>
                    <th>File Number</th>
                    <td><%= get_column_text(@claim, "text_mkpbm2ed") %></td>
                  </tr>
                  <tr>
                    <th>Policy Number</th>
                    <td><%= get_column_text(@claim, "text_mkpbbsfe") %></td>
                  </tr>
                  <tr>
                    <th>Date Filed</th>
                    <td><%= get_column_text(@claim, "date_mkpbcmn0") %></td>
                  </tr>
                  <tr>
                    <th>Date of Loss</th>
                    <td><%= get_column_text(@claim, "text_mkpbby4g") %></td>
                  </tr>
                  <tr>
                    <th>Type of Loss</th>
                    <td><%= get_column_text(@claim, "dropdown_mkpba4g7") %></td>
                  </tr>
                </table>
              </div>
              <div class="col-md-6">
                <table class="table table-borderless">
                  <tr>
                    <th>Insurer</th>
                    <td><%= get_column_text(@claim, "dropdown_mkpbw5qq") %></td>
                  </tr>
                  <tr>
                    <th>Client Name</th>
                    <td><%= get_column_text(@claim, "text_mkpb65jx") %></td>
                  </tr>
                  <tr>
                    <th>Assigned To</th>
                    <td><%= get_column_text(@claim, "text_mkpb3en0") %></td>
                  </tr>
                  <tr>
                    <th>Initials</th>
                    <td><%= get_column_text(@claim, "text_mkpb9dm8") %></td>
                  </tr>
                  <tr>
                    <th>Settlement Amount</th>
                    <td>
                      <% amount = get_column_text(@claim, "numeric_mkpba223") %>
                      <%= amount != "N/A" ? number_to_currency(amount.to_f) : "N/A" %>
                    </td>
                  </tr>
                  <tr>
                    <th>Fee Percentage</th>
                    <td>
                      <% fee = get_column_text(@claim, "numeric_mkpb6p5r") %>
                      <%= fee != "N/A" ? "#{fee}%" : "N/A" %>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Location Information -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-info text-white">
            <h3 class="mb-0">Location Information</h3>
          </div>
          <div class="card-body">
            <p class="mb-2"><strong>Full Address:</strong> <%= get_column_text(@claim, "location_mkpdbhwe") %></p>
            
            <div class="row mt-3">
              <div class="col-md-6">
                <p><strong>Street:</strong> <%= get_column_text(@claim, "text_mkpbnczf") %></p>
              </div>
              <div class="col-md-6">
                <p><strong>City:</strong> <%= get_column_text(@claim, "text_mkpbtbw5") %></p>
              </div>
            </div>
            
            <% 
              location_column = @claim["column_values"].find { |col| col["id"] == "location_mkpdbhwe" }
              lat = nil
              lng = nil
              
              if location_column && location_column["value"].present?
                begin
                  location_data = JSON.parse(location_column["value"])
                  if location_data["lat"].present? && location_data["lng"].present?
                    lat = location_data["lat"]
                    lng = location_data["lng"]
                  end
                rescue JSON::ParserError
                  # Handle parsing error
                end
              end
            %>
            
            <% if lat.present? && lng.present? %>
              <div class="mt-3">
                <div id="map" style="height: 300px; width: 100%;"></div>
                <script>
                  document.addEventListener('DOMContentLoaded', function() {
                    const map = L.map('map').setView([<%= lat %>, <%= lng %>], 15);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    }).addTo(map);
                    L.marker([<%= lat %>, <%= lng %>]).addTo(map)
                      .bindPopup("<%= get_column_text(@claim, "location_mkpdbhwe").gsub('"', '\"') %>")
                      .openPopup();
                  });
                </script>
              </div>
            <% end %>
          </div>
        </div>

        <% if @client.present? %>
          <!-- Client Information -->
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
              <h3 class="mb-0">Client Information</h3>
              <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLIENTS_BOARD_ID'] %>/pulses/<%= @client["id"] %>" class="btn btn-sm btn-light" target="_blank">
                <i class="bi bi-person"></i> View Client in Monday.com
              </a>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <table class="table table-borderless">
                    <tr>
                      <th>Name</th>
                      <td><%= @client["name"] %></td>
                    </tr>
                    <% 
                      # Look for common client fields - adjust these IDs based on your Monday.com setup
                      email_column = @client["column_values"].find { |col| col["id"].include?("email") || col["id"].include?("mail") }
                      phone_column = @client["column_values"].find { |col| col["id"].include?("phone") || col["id"].include?("tel") }
                    %>
                    <tr>
                      <th>Email</th>
                      <td>
                        <% if email_column && email_column["text"].present? %>
                          <a href="mailto:<%= email_column["text"] %>"><%= email_column["text"] %></a>
                        <% else %>
                          N/A
                        <% end %>
                      </td>
                    </tr>
                    <tr>
                      <th>Phone</th>
                      <td>
                        <% if phone_column && phone_column["text"].present? %>
                          <a href="tel:<%= phone_column["text"] %>"><%= phone_column["text"] %></a>
                        <% else %>
                          N/A
                        <% end %>
                      </td>
                    </tr>
                  </table>
                </div>
                <div class="col-md-6">
                  <% 
                    # Look for address fields - adjust these IDs based on your Monday.com setup
                    address_column = @client["column_values"].find { |col| col["id"].include?("address") }
                    city_column = @client["column_values"].find { |col| col["id"].include?("city") }
                    state_column = @client["column_values"].find { |col| col["id"].include?("state") }
                    zip_column = @client["column_values"].find { |col| col["id"].include?("zip") || col["id"].include?("postal") }
                  %>
                  <table class="table table-borderless">
                    <tr>
                      <th>Address</th>
                      <td><%= address_column && address_column["text"].present? ? address_column["text"] : "N/A" %></td>
                    </tr>
                    <tr>
                      <th>City</th>
                      <td><%= city_column && city_column["text"].present? ? city_column["text"] : "N/A" %></td>
                    </tr>
                    <tr>
                      <th>State</th>
                      <td><%= state_column && state_column["text"].present? ? state_column["text"] : "N/A" %></td>
                    </tr>
                    <tr>
                      <th>ZIP</th>
                      <td><%= zip_column && zip_column["text"].present? ? zip_column["text"] : "N/A" %></td>
                    </tr>
                  </table>
                </div>
              </div>
              
              <% 
                # Look for notes field
                notes_column = @client["column_values"].find { |col| col["id"].include?("notes") || col["type"] == "long_text" }
              %>
              <% if notes_column && notes_column["text"].present? %>
                <div class="mt-3">
                  <h5>Client Notes</h5>
                  <div class="p-3 bg-light rounded">
                    <%= simple_format(notes_column["text"]) %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- Optional: Display a message about client info not being available -->
          <!-- 
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
              <h3 class="mb-0">Client Information</h3>
            </div>
            <div class="card-body">
              <p class="text-muted">Client information is not available for this claim.</p>
            </div>
          </div>
          -->
        <% end %>
      </div>

      <!-- Sidebar Information -->
      <div class="col-md-4">
        <!-- Claim Details -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-secondary text-white">
            <h3 class="mb-0">Claim Details</h3>
          </div>
          <div class="card-body">
            <p><strong>Description:</strong></p>
            <div class="p-3 bg-light rounded mb-3">
              <%= simple_format(get_column_text(@claim, "long_text_mkpbktj8")) %>
            </div>
            
            <p><strong>Notes:</strong></p>
            <div class="p-3 bg-light rounded">
              <%= simple_format(get_column_text(@claim, "long_text_mkpbngk3")) %>
            </div>
          </div>
        </div>

        <!-- Additional Information -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Additional Information</h3>
          </div>
          <div class="card-body">
            <table class="table table-sm">
              <tr>
                <th>Deductible</th>
                <td>
                  <% deductible = get_column_text(@claim, "numeric_mkpbhft1") %>
                  <%= deductible != "N/A" ? number_to_currency(deductible.to_f) : "N/A" %>
                </td>
              </tr>
              <tr>
                <th>Claim Status</th>
                <td><%= get_column_text(@claim, "text_mkpbtjv7") %></td>
              </tr>
              <tr>
                <th>Last Updated</th>
                <td><%= get_column_text(@claim, "text_mkpb4vxc") %></td>
              </tr>
              <tr>
                <th>Assigned Person</th>
                <td><%= get_column_text(@claim, "person") %></td>
              </tr>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Debug Information (only in development) -->
    <% if Rails.env.development? %>
      <div class="card mt-4 mb-4">
        <div class="card-header bg-light">
          <h3 class="mb-0">Debug Information</h3>
        </div>
        <div class="card-body">
          <pre class="bg-light p-3"><%= JSON.pretty_generate(@claim) rescue @claim.inspect %></pre>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="alert alert-danger">
      <h3>Claim not found</h3>
      <p>The requested claim could not be found or there was an error retrieving the data.</p>
      <%= link_to "Return to Claims List", claims_path, class: "btn btn-primary mt-3" %>
    </div>
  <% end %>
</div>

<!-- Include Leaflet for maps -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>