<!-- app/views/claims/index.html.erb -->
<div class="container mt-4">
  <!-- Add inline CSS -->
  <style>
    .table-resizable th {
      position: relative;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    
    .column-resizer {
      position: absolute;
      top: 0;
      right: 0;
      width: 5px;
      height: 100%;
      background-color: transparent;
      cursor: col-resize;
      user-select: none;
      touch-action: none;
    }
    
    .column-resizer:hover,
    .column-resizer:active {
      background-color: rgba(0, 0, 0, 0.1);
    }
    
    body.resizing-columns {
      cursor: col-resize;
      user-select: none;
    }
  </style>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Claims</h1>
    <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLAIMS_BOARD_ID'] %>" class="btn btn-primary" target="_blank">
      <i class="bi bi-plus-circle"></i> New Claim
    </a>
  </div>

  <!-- Search form -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= form_with url: claims_path, method: :get, class: "row g-3", data: { turbo: false } do |f| %>
        <div class="col-md-4">
          <%= f.label :search, "Search", class: "form-label" %>
          <%= f.text_field :search, value: params[:search], class: "form-control", placeholder: "Search claims..." %>
        </div>
        <div class="col-md-3">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, 
                      [["All Statuses", ""], "Working On It", "Stuck", "Done", "Claim Closed", "In Progress", "Pending", "Denied"], 
                      { selected: params[:status] }, 
                      { class: "form-select" } %>
        </div>
        <div class="col-md-3">
          <%= f.label :sort, "Sort By", class: "form-label" %>
          <%= f.select :sort, 
                      [["Name (A-Z)", "name_asc"], ["Name (Z-A)", "name_desc"], 
                       ["Status (A-Z)", "status_asc"], ["Status (Z-A)", "status_desc"],
                       ["Date (Newest)", "date_desc"], ["Date (Oldest)", "date_asc"]], 
                      { selected: params[:sort] || "name_asc" }, 
                      { class: "form-select" } %>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <%= f.submit "Filter", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Expand/Collapse All Button -->
  <div class="mb-3">
    <button id="toggleAllGroups" class="btn btn-outline-secondary">
      <i class="bi bi-arrows-expand"></i> Expand/Collapse All
    </button>
  </div>

  <% if @claims_by_group.present? && @claims_by_group.any? %>
    <% @sorted_groups.each_with_index do |group_title, index| %>
      <% group_items = @claims_by_group[group_title] %>
      <% 
        # Pagination for this group
        total_pages = (group_items.size.to_f / @page_size).ceil
        start_index = (@page - 1) * @page_size
        end_index = [start_index + @page_size - 1, group_items.size - 1].min
        paginated_items = group_items[start_index..end_index]
        
        # Generate a unique ID for this group
        group_id = "group-#{group_title.parameterize}"
        
        # Check if this group should be expanded (default to expanded for the first group)
        expanded = index == 0
      %>
      
      <div class="card mb-4 shadow-sm group-card" id="<%= group_id %>-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="mb-0 d-flex align-items-center">
            <button class="btn btn-link text-decoration-none me-2 group-toggle" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#<%= group_id %>-body" 
                    aria-expanded="<%= expanded ? 'true' : 'false' %>"
                    aria-controls="<%= group_id %>-body">
              <i class="bi <%= expanded ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i>
            </button>
            <%= group_title %>
          </h3>
          <span class="badge bg-primary"><%= group_items.size %> claims</span>
        </div>
        
        <div class="collapse <%= expanded ? 'show' : '' %>" id="<%= group_id %>-body">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped table-hover mb-0 table-resizable">
                <thead>
                  <tr>
                    <th><%= sortable_column("Claim Name", "name") %></th>
                    <th><%= sortable_column("Status", "status") %></th>
                    <th><%= sortable_column("File Number", "file_number") %></th>
                    <th><%= sortable_column("Claim Number", "claim_number") %></th>
                    <th><%= sortable_column("Client Name", "client_name") %></th>
                    <th><%= sortable_column("Insurer", "insurer") %></th>
                    <th><%= sortable_column("Location", "location") %></th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% paginated_items.each do |claim| %>
                    <tr>
                      <td><%= claim["name"] %></td>
                      <td>
                        <% 
                          # Get the status column data
                          status_column = claim["column_values"].find { |col| col["id"] == "status" || col["title"] == "Status" }
                          
                          # Extract the text if the column exists and has text
                          status_text = if status_column && status_column["text"].present?
                                          status_column["text"]
                                        else
                                          "Unknown"
                                        end
                        %>
                        <span class="badge <%= status_badge_class(status_text) %>">
                          <%= status_text %>
                        </span>
                      </td>
                      <td><%= get_column_by_id_helper(claim, "text_mkpbm2ed") %></td>
                      <td><%= get_column_by_id_helper(claim, "text_mkpb2b25") %></td>
                      <td><%= get_column_by_id_helper(claim, "text_mkpb65jx") %></td>
                      <td>
                        <% 
                          # Get the insurer column data
                          insurer_column = claim["column_values"].find { |col| col["id"] == "dropdown_mkpbw5qq" }
                          
                          # Extract the text if the column exists and has text
                          insurer_text = if insurer_column && insurer_column["text"].present?
                                          insurer_column["text"]
                                        else
                                          "N/A"
                                        end
                        %>
                        <%= insurer_text %>
                      </td>
                      <td><%= get_column_by_id_helper(claim, "text_mkpb1zx4") %></td>
                      <td>
                        <div class="btn-group">
                          <%= link_to claim_path(claim["id"]), class: "btn btn-sm btn-primary" do %>
                            <i class="bi bi-eye"></i> View
                          <% end %>
                          <a href="https://mdf-public-adjuster.monday.com/boards/<%= ENV['MONDAY_CLAIMS_BOARD_ID'] %>/pulses/<%= claim["id"] %>" class="btn btn-sm btn-secondary" target="_blank">
                            <i class="bi bi-pencil"></i> Edit
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <% if total_pages > 1 %>
              <div class="card-footer">
                <nav aria-label="Page navigation">
                  <ul class="pagination justify-content-center mb-0">
                    <% if @page > 1 %>
                      <li class="page-item">
                        <%= link_to "Previous", claims_path(page: @page - 1, page_size: @page_size, search: params[:search], status: params[:status], sort: params[:sort]), class: "page-link" %>
                      </li>
                    <% else %>
                      <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                      </li>
                    <% end %>
                    
                    <% (1..total_pages).each do |page_num| %>
                      <li class="page-item <%= 'active' if page_num == @page %>">
                        <%= link_to page_num.to_s, claims_path(page: page_num, page_size: @page_size, search: params[:search], status: params[:status], sort: params[:sort]), class: "page-link" %>
                      </li>
                    <% end %>
                    
                    <% if @page < total_pages %>
                      <li class="page-item">
                        <%= link_to "Next", claims_path(page: @page + 1, page_size: @page_size, search: params[:search], status: params[:status], sort: params[:sort]), class: "page-link" %>
                      </li>
                    <% else %>
                      <li class="page-item disabled">
                        <span class="page-link">Next</span>
                      </li>
                    <% end %>
                  </ul>
                </nav>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="alert alert-info">
      <h4>No claims found</h4>
      <p>No claims match your search criteria. Try adjusting your filters or create a new claim.</p>
    </div>
  <% end %>

  <% if Rails.env.development? %>
    <div class="card mb-4">
      <div class="card-header">
        <h3>Debug Information</h3>
      </div>
      <div class="card-body">
        <p>Groups: <%= @sorted_groups.join(", ") %></p>
        <p>Claims by Group: <%= @claims_by_group.keys %></p>
        <p>Page: <%= @page %>, Page Size: <%= @page_size %></p>
        <% if @claims_data.present? %>
          <details>
            <summary>API Response</summary>
            <pre><%= JSON.pretty_generate(@claims_data) rescue @claims_data.inspect %></pre>
          </details>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Add inline JavaScript at the end of the file -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Setting up resizable columns');
      setupResizableColumns();
      
      // Toggle individual group
      const groupToggles = document.querySelectorAll('.group-toggle');
      groupToggles.forEach(toggle => {
        toggle.addEventListener('click', function() {
          const icon = this.querySelector('i');
          if (icon.classList.contains('bi-chevron-right')) {
            icon.classList.replace('bi-chevron-right', 'bi-chevron-down');
          } else {
            icon.classList.replace('bi-chevron-down', 'bi-chevron-right');
          }
        });
      });
      
      // Toggle all groups
      const toggleAllBtn = document.getElementById('toggleAllGroups');
      toggleAllBtn.addEventListener('click', function() {
        const allGroups = document.querySelectorAll('.group-card');
        const firstGroup = allGroups[0];
        const firstGroupBody = document.getElementById(firstGroup.id.replace('-card', '-body'));
        const isExpanded = firstGroupBody.classList.contains('show');
        
        allGroups.forEach(group => {
          const groupId = group.id.replace('-card', '');
          const groupBody = document.getElementById(groupId + '-body');
          const groupToggle = group.querySelector('.group-toggle i');
          
          if (isExpanded) {
            // Collapse all
            groupBody.classList.remove('show');
            groupToggle.classList.replace('bi-chevron-down', 'bi-chevron-right');
          } else {
            // Expand all
            groupBody.classList.add('show');
            groupToggle.classList.replace('bi-chevron-right', 'bi-chevron-down');
          }
        });
      });
    });

    function setupResizableColumns() {
      const tables = document.querySelectorAll('.table-resizable');
      console.log('Found tables:', tables.length);
      
      tables.forEach(table => {
        const headers = table.querySelectorAll('th');
        console.log('Found headers:', headers.length);
        
        headers.forEach((header, index) => {
          // Skip the Actions column (last column)
          if (index < headers.length - 1) {
            const resizer = document.createElement('div');
            resizer.classList.add('column-resizer');
            header.appendChild(resizer);
            setupResizer(resizer, header);
            console.log('Added resizer to:', header.textContent);
          }
        });
      });
    }

    function setupResizer(resizer, header) {
      let startX, startWidth;
      
      const mouseDownHandler = (e) => {
        e.preventDefault();
        startX = e.clientX;
        startWidth = header.offsetWidth;
        
        document.addEventListener('mousemove', mouseMoveHandler);
        document.addEventListener('mouseup', mouseUpHandler);
        
        // Add a class to the body to indicate we're resizing
        document.body.classList.add('resizing-columns');
        console.log('Started resizing:', header.textContent);
      };
      
      const mouseMoveHandler = (e) => {
        // Calculate the new width
        const width = startWidth + (e.clientX - startX);
        
        // Set a minimum width of 50px
        if (width >= 50) {
          header.style.width = `${width}px`;
          header.style.minWidth = `${width}px`;
          console.log('Resizing to:', width);
        }
      };
      
      const mouseUpHandler = () => {
        document.removeEventListener('mousemove', mouseMoveHandler);
        document.removeEventListener('mouseup', mouseUpHandler);
        document.body.classList.remove('resizing-columns');
        console.log('Finished resizing');
        
        // Save the width to localStorage
        const columnName = header.textContent.trim();
        const width = header.offsetWidth;
        saveColumnWidth(columnName, width);
      };
      
      resizer.addEventListener('mousedown', mouseDownHandler);
      
      // Apply saved width if available
      const savedWidth = getSavedColumnWidth(header.textContent.trim());
      if (savedWidth) {
        header.style.width = `${savedWidth}px`;
        header.style.minWidth = `${savedWidth}px`;
        console.log('Applied saved width:', savedWidth);
      }
    }

    function saveColumnWidth(columnName, width) {
      const storageKey = 'claimsTableColumnWidths';
      const savedWidths = JSON.parse(localStorage.getItem(storageKey) || '{}');
      savedWidths[columnName] = width;
      localStorage.setItem(storageKey, JSON.stringify(savedWidths));
      console.log('Saved width for:', columnName, width);
    }

    function getSavedColumnWidth(columnName) {
      const storageKey = 'claimsTableColumnWidths';
      const savedWidths = JSON.parse(localStorage.getItem(storageKey) || '{}');
      return savedWidths[columnName];
    }
  </script>
</div>